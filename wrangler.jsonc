{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-adnsdssss",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "33b98e3a-6ffd-4248-9ec2-788d01217437","database_name": "web-app1" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "289d63d311fe43fba16ad281a59b7400" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
